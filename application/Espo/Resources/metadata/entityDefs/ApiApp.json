            "index": true,
            "audited": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Active",
                "Inactive"
            ],
            "default": "Active",
            "maxLength": 8,
            "style": {
                "Inactive": "info"
            },
            "duplicateIgnore": true
        },
        "clientType": {
            "type": "enum",
            "options": [
                "Confidential",
                "Public"
            ],
            "default": "Confidential",
            "maxLength": 12,
            "audited": true
        },
        "clientId": {
            "type": "varchar",
            "readOnly": true,
            "maxLength": 36,
            "audited": true,
            "copyToClipboard": true,
            "duplicateIgnore": true
        },
        "redirectUrls": {
            "type": "urlMultiple",
            "protocolRequired": true,
            "audited": true
        },
        "scopes": {
            "type": "multiEnum",
            "audited": true,
            "displayAsList": true,
            "required": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true
        }
    },
    "links": {
